# Copy to .env (gitignored) and set the real paths for your machine. Read by docker compose.
UID=1000
GID=1000

# Directory of anime style reference images (e.g. data/style_refs/*.jpg),
# mounted at data/style_refs inside the container (see docker-compose.yml).
# configs/style_transfer/*.yml's `style_image:` paths are relative to this
# mount point (e.g. style_image: data/style_refs/12119910.jpg).
STYLE_REFS_DIR=./data/style_refs

# export-colmap-face service
# style_transfer.py --face_only output directory under ./output
EXPORT_FACE_SRC=sample04
# host directory the new dataset is written into
EXPORT_FACE_DST_DIR=/home/xr/DiffStyle3D/data
# name of the new dataset directory (must not exist yet)
EXPORT_FACE_DST=sample04_face
