# Copy to .env (gitignored). Read by docker compose.
UID=1000
GID=1000

# export-colmap-face service
# style_transfer.py --face_only output directory under ./output
EXPORT_FACE_SRC=sample04
# host directory the new dataset is written into
EXPORT_FACE_DST_DIR=/home/xr/DiffStyle3D/data
# name of the new dataset directory (must not exist yet)
EXPORT_FACE_DST=sample04_face
